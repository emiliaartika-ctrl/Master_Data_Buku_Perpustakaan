<%- include('../partials/header') %>

<h2>Master Data Buku Perpustakaan</h2>
<a href="/buku/tambah" class="btn btn-add">+ Tambah Buku Baru</a>

<table>
    <thead>
        <tr>
            <th>No</th>
            <th>Judul</th>
            <th>Penulis</th>
            <th>Kategori</th>
            <th>Stok</th>
            <th>Tgl Terbit</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% if (bukuList.length === 0) { %>
            <tr><td colspan="7" style="text-align:center;">Belum ada data buku.</td></tr>
        <% } else { %>
            <% bukuList.forEach((buku, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= buku.judul %></td>
                    <td><%= buku.penulis %></td>
                    <td><%= buku.kategori %></td>
                    <td><%= buku.stok %> eksemplar</td>
                    <td><%= new Date(buku.tanggal_terbit).toISOString().split('T')[0] %></td>
                    <td>
                        <a href="/buku/edit/<%= buku.id %>" class="btn btn-edit">Edit</a>
                        <form action="/buku/hapus/<%= buku.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus buku ini?');">
                            <button type="submit" class="btn btn-delete">Hapus</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        <% } %>
    </tbody>
</table>

<%- include('../partials/footer') %>